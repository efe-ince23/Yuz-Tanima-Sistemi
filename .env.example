POSTGRES_DB=yuz_tanima
POSTGRES_USER=yuz_tanima_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@yuztanima.com
PGADMIN_DEFAULT_PASSWORD=change_this_password
PGADMIN_PORT=5050

# API'nin bilgisayarda ve container icinde dinleyecegi portlar.
API_HOST_PORT=8000
API_PORT=8000
FRONTEND_PORT=3000

# Kalici yuz fotograflarinin container ve bilgisayar yollari.
DATA_ROOT=/app/data
FACE_DATA_PATH=./data

# Yuz modeli ve tanima esikleri.
FACE_MODEL_NAME=buffalo_sc
FACE_ENGINE=yolo_arcface
YOLO_FACE_MODEL_PATH=/app/models/yolov8n-face.onnx
YOLO_FACE_INPUT_SIZE=640
YOLO_FACE_CONFIDENCE=0.25
YOLO_FACE_NMS_THRESHOLD=0.45
YOLO_FACE_MIN_ASPECT_RATIO=0.40
YOLO_FACE_MAX_ASPECT_RATIO=1.80
ARCFACE_MODEL_PATH=/app/models/arcface-r50-w600k.onnx
ARCFACE_BATCH_SIZE=16
BENCHMARK_OUTPUT_ROOT=/artifacts/benchmarks
VIDEO_ACCEPTANCE_OUTPUT_ROOT=/artifacts/video-acceptance/runs
LFW_PAIRS_FILE=/datasets/lfw/pairs.csv
FACE_ENABLE_TENSORRT=true
ARCFACE_ENABLE_TENSORRT=false
TENSORRT_FP16_ENABLE=false
TENSORRT_CACHE_ROOT=/app/tensorrt-cache
FACE_MATCH_THRESHOLD=0.45
FACE_ANONYMOUS_MATCH_THRESHOLD=0.45
FACE_DUPLICATE_THRESHOLD=0.55
ANONYMOUS_FACE_MAX_SAMPLES=5
ANONYMOUS_FACE_DUPLICATE_THRESHOLD=0.98
PRIMARY_FACE_DOMINANCE_RATIO=2.0

# Qdrant vektor veritabani.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_PREFER_GRPC=true
QDRANT_COLLECTION=face_embeddings_arcface_r50_v1
FACE_EMBEDDING_MODEL_VERSION=arcface_r50_w600k_v1
QDRANT_INDEXING_THRESHOLD_KB=1000
QDRANT_FULL_SCAN_THRESHOLD_KB=1000

# Video processing limits (first release).
VIDEO_MAX_SIZE_MB=200
VIDEO_MAX_DURATION_SECONDS=300
VIDEO_SAMPLE_FPS=6
VIDEO_TRACK_MAX_GAP_SECONDS=0.75
VIDEO_SCENE_CUT_ENABLED=true
VIDEO_SCENE_CUT_HISTOGRAM_CORRELATION=0.35
VIDEO_SCENE_CUT_PIXEL_DIFFERENCE=0.10
VIDEO_TRACK_MIN_IOU=0.10
VIDEO_TRACK_MAX_CENTER_DISTANCE=0.25
VIDEO_TRACK_MAX_AREA_RATIO=3.0
VIDEO_TRACK_APPEARANCE_ENABLED=true
VIDEO_TRACK_APPEARANCE_MIN_SIMILARITY=0.20
VIDEO_TRACK_APPEARANCE_WEIGHT=0.45
VIDEO_TRACK_APPEARANCE_MOMENTUM=0.80
VIDEO_TRACKER_ENGINE=custom
VIDEO_BYTETRACK_ACTIVATION_THRESHOLD=0.15
VIDEO_BYTETRACK_MATCHING_THRESHOLD=0.90
VIDEO_BYTETRACK_MINIMUM_CONSECUTIVE_FRAMES=1
VIDEO_RECOGNITION_SAMPLES_PER_TRACK=3
VIDEO_RECOGNITION_SAMPLES_PER_WINDOW=3
VIDEO_RECOGNITION_WINDOW_SECONDS=3
VIDEO_ANONYMOUS_MIN_OBSERVATIONS=2
VIDEO_ANONYMOUS_MIN_QUALITY_SAMPLES=3
VIDEO_ANONYMOUS_MIN_QUALITY=0.50
VIDEO_ANONYMOUS_MIN_FRONTAL_SCORE=0.35
VIDEO_ANONYMOUS_MIN_DURATION_SECONDS=0.8
VIDEO_ANONYMOUS_MIN_DETECTION_CONFIDENCE=0.50
VIDEO_ANONYMOUS_MIN_FACE_SIZE_PX=64
VIDEO_ANONYMOUS_MIN_SHARPNESS=35
VIDEO_ANONYMOUS_MIN_EMBEDDING_CONSISTENCY=0.35
VIDEO_ANONYMOUS_SINGLE_MIN_QUALITY=0.60
VIDEO_ANONYMOUS_SINGLE_MIN_FRONTAL_SCORE=0.65
VIDEO_ANONYMOUS_SINGLE_MIN_DETECTION_CONFIDENCE=0.75
VIDEO_ANONYMOUS_SINGLE_MIN_FACE_SIZE_PX=80
VIDEO_ANONYMOUS_SINGLE_MIN_SHARPNESS=55
VIDEO_RECOGNITION_STRONG_MATCH_MARGIN=0.08
VIDEO_RECOGNITION_WEAK_MATCH_MIN_DURATION_SECONDS=1.0
VIDEO_RECOGNITION_SHORT_KNOWN_MIN_DETECTION_CONFIDENCE=0.50
VIDEO_RECOGNITION_BRIDGE_WINDOW_COUNT=1
VIDEO_RECOGNITION_CONTINUITY_WINDOWS=4
VIDEO_RECOGNITION_CONTINUITY_THRESHOLD=0.30
VIDEO_RECOGNITION_CONTINUITY_DISTANCE_PENALTY=0.03
VIDEO_REID_GALLERY_SIZE=5
VIDEO_REID_MIN_SIMILARITY=0.30
VIDEO_ANONYMOUS_SHORT_MIN_OBSERVATIONS=4
VIDEO_ANONYMOUS_SHORT_MIN_DURATION_SECONDS=0.5
VIDEO_PROCESSING_CONCURRENCY=1
VIDEO_ARCFACE_FRAME_BATCH_SIZE=1
VIDEO_ALLOWED_CONTENT_TYPES=video/mp4
VIDEO_ALLOWED_CONTAINERS=mp4
VIDEO_ALLOWED_CODECS=h264
FACE_VECTOR_SIZE=512
QDRANT_UPSERT_BATCH_SIZE=256

# LFW toplu aktarim yolu (backend container icinden).
LFW_DATASET_ROOT=/datasets/lfw/lfw-deepfunneled/lfw-deepfunneled

# MinIO nesne depolama servisi. Gercek ortamda guclu ve benzersiz degerler kullanin.
MINIO_ROOT_USER=faceadmin
MINIO_ROOT_PASSWORD=change_this_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=faceadmin
MINIO_SECRET_KEY=change_this_password
MINIO_BUCKET=face-images
MINIO_SECURE=false
MIGRATE_LEGACY_OBJECTS_ON_STARTUP=false

# Kimlik dogrulama. AUTH_SECRET_KEY icin en az 32 karakterlik rastgele bir deger kullanin.
AUTH_SECRET_KEY=change_this_to_a_long_random_secret
AUTH_ACCESS_MINUTES=30
AUTH_REFRESH_DAYS=7
AUTH_COOKIE_SECURE=false
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@example.local
ADMIN_INITIAL_FULL_NAME="Sistem Yöneticisi"
ADMIN_INITIAL_PASSWORD=change_this_admin_password
